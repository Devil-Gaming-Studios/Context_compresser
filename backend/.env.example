# Copy this file to .env in the same directory (backend/.env) and fill in
# your token. .env is gitignored -- never commit a real token.
#
# Optional. Only needed for POST /compress/diff/github (and the CLI's
# --github-pr flag) when:
#   - the PR is on a private repo, or
#   - you're hitting GitHub's 60-requests/hour anonymous rate limit.
#
# Create a token at https://github.com/settings/tokens with the read-only
# "public_repo" scope (or "repo" if you need private repos).
GITHUB_TOKEN=
